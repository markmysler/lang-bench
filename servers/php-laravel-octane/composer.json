{
    "name": "lang-bench/php-laravel-octane",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "13.39.0",
        "laravel/octane": "2.22.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
