#!/bin/sh
# Sourced by the release's start script. One BEAM scheduler (and dirty CPU scheduler default)
# per pinned CPU: +S CPUS:CPUS.
case "$CPUS" in
  '' | *[!0-9]* | 0) ;;
  *) export ERL_FLAGS="+S $CPUS:$CPUS $ERL_FLAGS" ;;
esac
# A single node with no clustering, so no distribution and no epmd.
export RELEASE_DISTRIBUTION=none
